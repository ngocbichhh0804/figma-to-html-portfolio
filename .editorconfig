# Giữ định dạng file thống nhất giữa mọi editor, không phụ thuộc cài đặt cá nhân.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown dùng hai dấu cách cuối dòng để xuống dòng, nên không cắt khoảng trắng.
[*.md]
trim_trailing_whitespace = false
